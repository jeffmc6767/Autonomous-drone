# Target name: FC
# Board: Custom FC
# Architecture: STM32F411CEU6

board_name jFC
manufacturer_id Jacy

# Feature Flags
feature OSD
feature TELEMETRY
feature MOTOR_STOP

# Master Settings
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set gyro_1_sensor_align = CW0
set align_mag = DEFAULT
set battery_meter = ADC
set current_meter = ADC
set ibata_scale = 179
set vbat_scale = 110

# Resource Allocations
# Status LEDs & Beeper
resource LED 1 A13
resource BEEPER 1 C15

# SPI 1 (BMI270 IMU)
resource SPI_SCK 1 A05
resource SPI_MISO 1 A06
resource SPI_MOSI 1 A07
resource GYRO_CS 1 A04
resource GYRO_EXTI 1 A01

# Motor Outputs (DShot Timers)
resource MOTOR 1 B00
resource MOTOR 2 B01
resource MOTOR 3 B04
resource MOTOR 4 B05

# UARTs
# UART1: DJI O4 Air Unit (MSP DisplayPort / Telemetry)
resource SERIAL_TX 1 A09
resource SERIAL_RX 1 A10

# UART2: External RC Receiver (ELRS / CRSF / SBUS)
resource SERIAL_TX 2 A02
resource SERIAL_RX 2 A03

# Analog Inputs (ADC)
resource ADC_BATT 1 B02
resource ADC_CURR 1 B03

# Save Configuration
save